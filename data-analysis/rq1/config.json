{
    "data_file": "combined_all_data.csv",
    "output_plot": "time_prediction_results.png",

    "use_log_transform": true,
    "use_time_per_step": true,
    "create_interactions": true,
    "train_per_game": true,

    "features": {
        "hardware": ["physical_cores", "system_ram_gb"],
        "hyperparameters": ["batch_size", "learning_rate", "max_steps", "buffer_size", "hidden_units", "num_layers", "time_horizon"]
    },

    "target": "total_time_seconds",

    "train_test_split": {
        "test_size": 0.2,
        "random_state": 42
    },

    "models": {
        "linear_regression": true,
        "random_forest": {
            "enabled": true,
            "n_estimators": 100,
            "max_depth": 10,
            "min_samples_leaf": 3
        }
    }
}
